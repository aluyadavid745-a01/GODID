rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == customerId);
      allow write: if isAdmin() || (signedIn() && request.auth.uid == customerId);
    }

    match /newsletterSubscribers/{subscriberId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
