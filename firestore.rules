rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true || exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)));
    }

    match /adminUsers/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read, write: if isAdmin();
    }

    match /storefront/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if
        request.resource.data.keys().hasOnly(['id', 'orderNumber', 'customerId', 'customerName', 'customerEmail', 'customerPhone', 'items', 'address', 'status', 'paymentStatus', 'paymentProvider', 'deliveryMethod', 'totals', 'createdAt', 'createdAtServer', 'pricingStatus']) &&
        request.resource.data.keys().hasAll(['id', 'orderNumber', 'customerId', 'customerName', 'customerEmail', 'customerPhone', 'items', 'address', 'status', 'paymentStatus', 'paymentProvider', 'deliveryMethod', 'totals', 'createdAt', 'createdAtServer', 'pricingStatus']) &&
        request.resource.data.id == orderId &&
        request.resource.data.orderNumber is string && request.resource.data.orderNumber.matches('^#COL-[A-Z0-9]{12}$') &&
        request.resource.data.customerId == (signedIn() ? request.auth.uid : 'guest') &&
        request.resource.data.status == 'pending' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.paymentProvider == 'whatsapp' &&
        request.resource.data.pricingStatus == 'unverified' &&
        request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 120 &&
        request.resource.data.customerEmail is string && request.resource.data.customerEmail.size() <= 254 &&
        request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() <= 30 &&
        request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 20 &&
        request.resource.data.address is map &&
        request.resource.data.totals is map &&
        request.resource.data.totals.total is number && request.resource.data.totals.total >= 0 &&
        request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40 &&
        request.resource.data.createdAtServer == request.time;
      allow update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == customerId);
      allow write: if isAdmin() || (signedIn() && request.auth.uid == customerId);
    }

    match /newsletterSubscribers/{subscriberId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
